# Contents of the `pve-tfvars` Secret referenced by workspace.yaml, under the
# key `terraform.tfvars`. Create it with:
#
#   kubectl create secret generic pve-tfvars \
#     --from-file=terraform.tfvars=./terraform.tfvars
#
# This is real HCL, so list variables work here — unlike spec.forProvider.vars,
# which is string-only.

pve_api_url        = "https://ul-pve01.labul.sva.de:8006/api2/json"
pve_api_user       = "terraform@pve"
pve_api_password   = "CHANGEME"
pve_api_tls_verify = false

vm_ci_password = "CHANGEME"

vm_ci_ssh_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... sthings@workstation",
]

vm_tags = ["kind", "labul", "crossplane"]
